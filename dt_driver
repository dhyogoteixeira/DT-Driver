<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DT Driver — Solicitar Corrida</title>

    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <style>
        /* --- ESTILOS GERAIS E LAYOUT (DARK MODE) --- */
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #121212; /* Fundo escuro */
            color: #E0E0E0; /* Texto claro */
        }
        header {
            padding: 20px 5%;
            font-size: 24px;
            color: #00aaff;
            font-weight: bold;
        }
        .container {
            display: flex;
            flex-wrap: wrap;
            padding: 20px 5%;
            gap: 30px;
        }
        .formulario, .resumo {
            background: #1F1F1F;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
        }
        .formulario {
            flex: 2;
            min-width: 300px;
        }
        .resumo {
            flex: 1;
            min-width: 250px;
            max-height: 700px; /* Limita a altura do painel de resumo */
            position: sticky;
            top: 20px;
        }

        /* --- ESTILOS DE FORMULÁRIO --- */
        label, input, textarea, button {
            display: block;
            width: 100%;
            margin-bottom: 15px;
        }
        input, textarea {
            padding: 12px;
            border: 1px solid #333;
            border-radius: 8px;
            background: #252525;
            color: #E0E0E0;
            font-size: 16px;
        }
        input::placeholder, textarea::placeholder {
            color: #888;
        }
        
        /* Botões */
        .btn-group {
            display: flex;
            gap: 10px;
        }
        .btn-group button {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
        }
        #btnCalcular {
            background: #00aaff;
            color: #1F1F1F;
        }
        #btnSolicitar {
            background: #00c853; /* Verde para solicitação */
            color: white;
            opacity: 0.5; /* Inicialmente desabilitado */
            pointer-events: none; /* Não clicável até calcular */
        }
        #btnLocalizacao {
            background: none;
            color: #00aaff;
            border: 1px solid #00aaff;
            padding: 8px;
            font-size: 14px;
            margin-bottom: 20px;
        }
        .btn-group button:hover {
            opacity: 0.8;
        }

        /* --- ESTILOS DE RESUMO E MAPA --- */
        #map {
            height: 250px;
            width: 100%;
            border-radius: 8px;
            margin-top: 15px;
            margin-bottom: 20px;
        }
        .resumo-info, .resumo-erro {
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            margin-bottom: 20px;
        }
        .resumo-info {
            background: #252525;
        }
        .resumo-erro {
            background: #ff5252; /* Vermelho de erro */
            color: white;
        }
        #estimativaPreco {
            font-size: 20px;
            font-weight: bold;
            color: #00c853;
        }
        .footer-info {
            font-size: 12px;
            margin-top: 20px;
            border-top: 1px solid #333;
            padding-top: 10px;
            color: #888;
        }
    </style>
</head>
<body>
    <header>
        <span style="color: white;">DT</span> Driver — Solicitar Corrida
        <p style="font-size: 14px; font-weight: normal; color: #888; margin: 0;">Site simples pronto para publicar no GitHub Pages</p>
    </header>

    <div class="container">
        <div class="formulario">
            <h3>Detalhes da Corrida</h3>
            <input type="text" id="nomePassageiro" placeholder="Nome do passageiro (Ex: João Silva)">
            <input type="tel" id="telefone" placeholder="Telefone (para contato / WhatsApp) (Ex: 55 21 99999-9999)">
            
            <label for="origem">Local de partida (endereço)</label>
            <input type="text" id="origem" placeholder="Rua, número, bairro, cidade">
            
            <label for="destino">Destino (endereço)</label>
            <input type="text" id="destino" placeholder="Rua, número, bairro, cidade">
            
            <button id="btnLocalizacao" onclick="usarMinhaLocalizacao()">Usar minha localização (Preenche coordenadas aproximadas)</button>

            <label for="observacoes">Observações</label>
            <textarea id="observacoes" placeholder="Mais bagagem, pets, preferência de motorista..."></textarea>
            
            <div class="btn-group">
                <button id="btnCalcular" onclick="calcularRota()">Calcular valor estimado</button>
                <button id="btnSolicitar" onclick="solicitarCorrida()">Solicitar corrida</button>
            </div>
            
            <p style="font-size: 12px; color: #888; margin-top: 20px;">
                Dica: para aceitar pagamentos ou integração de notificações, adicione um backend (ex: Firebase, Node.js + Twilio/WhatsApp API).
            </p>
        </div>

        <div class="resumo">
            <h3>Resumo do pedido</h3>
            
            <div class="resumo-info" id="statusResumo">
                Sem pedido
                <p style="font-size: 14px; color: #888;">Preencha origem e destino e clique em "Calcular valor estimado".</p>
            </div>

            <div id="map"></div>
            
            <p>Valor base: **R$ 5.00**</p>
            <p>Preço por km: **R$ 2.50**</p>
            <p>Estimativa: <span id="estimativaPreco">R$ --</span></p>
            <p id="distanciaInfo" style="font-size: 14px; color: #888;">Distância: 0.00 km</p>
            
            <hr style="border-color: #333;">
            <p style="font-size: 14px;">Número do motorista/empresa (para gerar mensagem WhatsApp)</p>
            <p style="font-weight: bold;">55 21 99921-2228</p> </div>
    </div>

    <p style="text-align: center; color: #555; font-size: 12px; padding: 20px;">
        Feito para você — personalize cores, tarifas e integre APIs. Deploy no GitHub: crie um repositório com esse index.html e ative GitHub Pages.
    </p>

    <script>
        // --- CONFIGURAÇÕES DE TARIFA ---
        const TARIFA_BASE = 5.00; 
        const TARIFA_KM = 2.50;  
        const NUMERO_WHATSAPP = '5521999212228'; // NÚMERO DE CONTATO ATUALIZADO PARA 5521999212228

        let map = L.map('map').setView([-22.9068, -43.1729], 12); // Ponto inicial (Rio de Janeiro)
        let routeLayer;
        let ultimaEstimativa = { origem: '', destino: '', preco: 0, distancia: 0 };

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
        }).addTo(map);

        // --- FUNÇÕES DE GEOLOCALIZAÇÃO E ROTEAMENTO ---

        async function geocode(endereco) {
            try {
                const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${endereco}&limit=1`);
                const results = await response.json();
                if (results.length > 0) {
                    return [parseFloat(results[0].lat), parseFloat(results[0].lon)];
                }
                return null;
            } catch (error) {
                console.error("Erro ao geocodificar:", error);
                return null;
            }
        }

        async function getRoute(origCoord, destCoord) {
            // OSRM espera lon, lat
            const url = `https://router.project-osrm.org/route/v1/driving/${origCoord[1]},${origCoord[0]};${destCoord[1]},${destCoord[0]}?overview=full&geometries=geojson`;
            
            try {
                const response = await fetch(url);
                const data = await response.json();

                if (data.routes && data.routes.length > 0) {
                    const route = data.routes[0];
                    const distanceKM = route.distance / 1000;
                    return { distanceKM: distanceKM, geometry: route.geometry };
                }
                return null;
            } catch (error) {
                console.error("Erro ao calcular rota OSRM:", error);
                return null;
            }
        }

        // --- FUNÇÃO PARA USAR A LOCALIZAÇÃO DO USUÁRIO ---
        function usarMinhaLocalizacao() {
            document.getElementById("statusResumo").innerHTML = 'Buscando sua localização...';

            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition(async (position) => {
                    const lat = position.coords.latitude;
                    const lon = position.coords.longitude;
                    
                    // Reverte as coordenadas para um endereço aproximado (Geocoder)
                    const reverseUrl = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`;
                    const response = await fetch(reverseUrl);
                    const data = await response.json();
                    
                    // Tenta usar um nome de lugar decente
                    const enderecoAprox = data.display_name || `Coordenadas: ${lat.toFixed(4)}, ${lon.toFixed(4)}`;
                    
                    document.getElementById("origem").value = enderecoAprox;
                    document.getElementById("statusResumo").innerHTML = 'Localização de partida preenchida!';
                    
                    calcularRota();
                }, (error) => {
                    document.getElementById("statusResumo").innerHTML = `<span style="color: #ff5252;">Erro: ${error.message}</span>. Preencha manualmente.`;
                    console.error("Erro de geolocalização:", error);
                });
            } else {
                alert("Geolocalização não é suportada pelo seu navegador.");
            }
        }

        // --- FUNÇÃO PRINCIPAL DE CÁLCULO ---
        async function calcularRota() {
            const origem = document.getElementById("origem").value;
            const destino = document.getElementById("destino").value;
            const btnSolicitar = document.getElementById("btnSolicitar");
            const statusResumo = document.getElementById("statusResumo");

            btnSolicitar.style.opacity = 0.5;
            btnSolicitar.style.pointerEvents = 'none';

            if (!origem || !destino) {
                statusResumo.className = 'resumo-erro';
                statusResumo.innerHTML = 'Preencha origem e destino para calcular.';
                document.getElementById("estimativaPreco").innerText = 'R$ --';
                document.getElementById("distanciaInfo").innerText = 'Distância: 0.00 km';
                return;
            }
            
            statusResumo.className = 'resumo-info';
            statusResumo.innerHTML = 'Calculando rota...';

            const [origCoord, destCoord] = await Promise.all([
                geocode(origem),
                geocode(destino)
            ]);

            if (!origCoord || !destCoord) {
                statusResumo.className = 'resumo-erro';
                statusResumo.innerHTML = 'Ops! Um ou ambos os endereços não foram encontrados.';
                return;
            }

            const routeData = await getRoute(origCoord, destCoord);

            if (!routeData) {
                statusResumo.className = 'resumo-erro';
                statusResumo.innerHTML = 'Erro ao calcular a rota de carro. Tente endereços mais precisos.';
                return;
            }

            const { distanceKM, geometry } = routeData;
            const preco = TARIFA_BASE + (distanceKM * TARIFA_KM);
            
            // 1. Salva a última estimativa para o WhatsApp
            ultimaEstimativa = { 
                origem: origem, 
                destino: destino, 
                preco: preco.toFixed(2), 
                distancia: distanceKM.toFixed(2) 
            };

            // 2. Atualiza o Mapa
            if (routeLayer) map.removeLayer(routeLayer);
            routeLayer = L.geoJSON(geometry).addTo(map);
            map.fitBounds(routeLayer.getBounds());
            
            // 3. Exibe o Preço
            statusResumo.className = 'resumo-info';
            statusResumo.innerHTML = 'Cálculo Concluído!';
            document.getElementById("estimativaPreco").innerText = `R$ ${preco.toFixed(2)}`;
            document.getElementById("distanciaInfo").innerText = `Distância: ${distanceKM.toFixed(2)} km`;

            // 4. Habilita o botão Solicitar
            btnSolicitar.style.opacity = 1;
            btnSolicitar.style.pointerEvents = 'auto';
        }

        // --- FUNÇÃO PARA ABRIR O WHATSAPP ---
        function solicitarCorrida() {
            if (ultimaEstimativa.preco === 0) {
                 alert("Primeiro, calcule o valor da corrida.");
                 return;
            }
            
            const nome = document.getElementById("nomePassageiro").value || "Cliente";
            const telefone = document.getElementById("telefone").value || "Não informado";
            const obs = document.getElementById("observacoes").value || "Nenhuma";
            
            const mensagem = `🚗 *SOLICITAÇÃO DE CORRIDA - DT DRIVER*%0A%0A` +
                             `👤 Nome: ${encodeURIComponent(nome)}%0A` +
                             `📞 Telefone: ${encodeURIComponent(telefone)}%0A%0A` +
                             `📍 *Origem:* ${encodeURIComponent(ultimaEstimativa.origem)}%0A` +
                             `🏁 *Destino:* ${encodeURIComponent(ultimaEstimativa.destino)}%0A%0A` +
                             `💲 *Valor Estimado:* R$ ${ultimaEstimativa.preco}%0A` +
                             `📏 Distância: ${ultimaEstimativa.distancia} km%0A%0A` +
                             `🗒️ *Observações:* ${encodeURIComponent(obs)}`;
            
            const link = `https://wa.me/${NUMERO_WHATSAPP}?text=${mensagem}`;
            window.open(link, '_blank');
        }
    </script>
</body>
</html>
